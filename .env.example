DEVPLATFORM_ENVIRONMENT=dev
DEVPLATFORM_DATABASE_URL=sqlite:///./dev_platform.db
DEVPLATFORM_WORKER_ENABLED=true
DEVPLATFORM_WORKER_POLL_INTERVAL_SECONDS=0.25
DEVPLATFORM_WORKER_LEASE_TIMEOUT_SECONDS=30
DEVPLATFORM_WORKER_HEARTBEAT_INTERVAL_SECONDS=1
DEVPLATFORM_WORKER_RECOVERY_INTERVAL_SECONDS=5
DEVPLATFORM_SYNCHRONOUS_WAIT_TIMEOUT_SECONDS=60
DEVPLATFORM_DEFAULT_STEP_TIMEOUT_SECONDS=30
DEVPLATFORM_DEFAULT_STEP_MAX_ATTEMPTS=3
DEVPLATFORM_RETRY_BASE_DELAY_SECONDS=0.1
# Used only by the stdio MCP entry point.
DEVPLATFORM_API_KEY=dp_replace_with_an_active_key
